---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const steps = [
  {
    n: '01',
    t: '聊聊想法',
    d: '告诉我你想要什么——参考图、场合、人数、预算范围，都可以说。',
  },
  {
    n: '02',
    t: '定下方案',
    d: '一起讨论地点、时间和拍摄清单，我会给出完整的方案与报价。',
  },
  {
    n: '03',
    t: '按下快门',
    d: '拍摄当天什么都不用准备，放松地做你自己就好。',
  },
];

const scopes = ['个人写真', '情侣 / 闺蜜', '跟拍记录', '形象照', '私服轻婚纱'];
---

<Base title={`联系与约拍 · ${site.titleSuffix}`}>
  <section class="container contact">
    <header class="js-reveal">
      <p class="label">Contact</p>
      <h1 class="display-lg">一起，拍点什么</h1>
      <p class="sub">
        无论是一组人像、一场city walk，还是一次合作——从这里开始。
        我通常会在 24 小时内回复。
      </p>
    </header>

    <div class="contact-grid">
      <div class="info js-reveal">
        <p class="label">直接联系</p>
        <a class="email" href={`mailto:${site.email}`}>{site.email}</a>

        <p class="label" style="margin-top: 2.5rem;">社交账号</p>
        <ul class="social-list">
          {
            site.socials.filter((s) => s.name !== '邮箱').map((s) => (
              <li>
                <a href={s.url} rel="noopener">
                  <span class="s-name">{s.name}</span>
                  <span class="s-handle">{s.handle}</span>
                  <span class="s-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="social-note">微信添加请备注「约拍」，抖音私信也可以找到我。</p>

        <p class="label" style="margin-top: 2.5rem;">常驻</p>
        <p class="body">{site.location}（可异地 / 旅拍）</p>
      </div>

      <div class="right js-reveal" style="--reveal-delay: 120ms">
        <p class="label">约拍流程</p>
        <ol class="steps">
          {
            steps.map((s) => (
              <li>
                <span class="step-n">{s.n}</span>
                <div>
                  <h2>{s.t}</h2>
                  <p>{s.d}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <p class="label" style="margin-top: 2.75rem;">拍摄方向</p>
        <ul class="scopes">
          {scopes.map((s) => (<li>{s}</li>))}
        </ul>

        <a href={`mailto:${site.email}?subject=约拍咨询`} class="btn btn--solid mail-btn">
          发邮件，开始对话
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact {
    padding-top: calc(var(--nav-h) + 4.5rem);
  }

  header { max-width: 640px; }

  .sub {
    color: var(--text-secondary);
    margin-top: 1.25rem;
    max-width: 44ch;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 4.5rem;
    margin-top: 4rem;
  }

  .email {
    display: inline-block;
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.35rem, 2.6vw, 1.9rem);
    color: var(--text);
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 0.3rem;
    transition: color 0.3s var(--ease-out), border-color 0.3s var(--ease-out);
  }

  .email:hover {
    color: var(--accent-hover);
    border-color: var(--accent);
  }

  .social-list {
    list-style: none;
    margin-top: 1.25rem;
    display: grid;
    gap: 0.75rem;
  }

  .social-list a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
    transition: color 0.3s var(--ease-out);
  }

  .social-list a:hover { color: var(--accent-hover); }

  .s-name { letter-spacing: 0.14em; font-size: 0.9rem; }

  .s-handle {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .s-arrow {
    margin-left: auto;
    color: var(--text-muted);
    transition: transform 0.35s var(--ease-out);
  }

  .social-list a:hover .s-arrow { transform: translateX(4px); }

  .social-note {
    margin-top: 1rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .body { color: var(--text-secondary); margin-top: 1rem; }

  .steps {
    list-style: none;
    margin-top: 1.5rem;
    display: grid;
    gap: 1.75rem;
    counter-reset: step;
  }

  .steps li {
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    gap: 1.25rem;
  }

  .step-n {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.5rem;
    color: var(--accent);
    line-height: 1.2;
  }

  .steps h2 {
    font-size: 1.15rem;
    margin-bottom: 0.35rem;
  }

  .steps p {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .scopes {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .scopes li {
    padding: 0.45rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    color: var(--text-secondary);
  }

  .mail-btn { margin-top: 2.5rem; }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; gap: 3.5rem; }
  }
</style>
