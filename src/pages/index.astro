---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import AlbumCard from '../components/AlbumCard.astro';
import { site } from '../data/site';
import { albums } from '../data/albums';
import { getAlbumCover } from '../lib/photos';
import heroImg from '../assets/hero.jpg';

const featured = albums.slice(0, 4).map((a) => ({
  album: a,
  cover: getAlbumCover(a.slug, a.cover),
}));
const yearSpan = new Date().getFullYear() - site.since + 1;

// 不对称编辑感网格：宽 / 窄 / 窄 / 宽
const patterns = ['wide', 'tall', 'tall', 'wide'] as const;
---

<Base title={`${site.brand} · ${site.name} 摄影作品集`}>
  <!-- Hero -->
  <section class="hero" aria-label="首页主视觉">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="label">{site.role} · {site.location}</p>
        <h1 class="display-xl">
          把每一次<br /><em>心动</em>，都留在光里
        </h1>
        <p class="hero__intro">
          我是 {site.name}，一名{site.role}。用镜头捕捉每个人最真实、也最发亮的那个瞬间——
          不摆拍，只记录喜欢。
        </p>
        <div class="hero__cta">
          <a href="/albums/" class="btn btn--solid">进入作品</a>
          <a href="/contact/" class="btn">约拍合作</a>
        </div>
      </div>

      <div class="hero__visual">
        <div class="hero__frame">
          <Image
            src={heroImg}
            alt="黄昏逆光下的人像，发丝被染成琥珀色"
            widths={[640, 960, 1200]}
            sizes="(max-width: 760px) 100vw, 50vw"
            loading="eager"
            class="hero__img"
          />
        </div>
        <span class="hero__badge" aria-hidden="true">{albums.length} 组人像作品</span>
      </div>
    </div>

    <div class="hero__meta" aria-hidden="true">
      <span>{site.since} 年拿起相机</span>
      <span class="dot"></span>
      <span>{albums.length} 个主题专辑</span>
      <span class="dot"></span>
      <span>{yearSpan} 年，专注人像</span>
    </div>
  </section>

  <!-- 精选作品 -->
  <section class="container">
    <div class="section-title js-reveal">
      <h2>精选作品</h2>
      <span class="count">Selected Works</span>
      <a href="/albums/" class="all-link">全部作品 →</a>
    </div>

    <div class="works-grid">
      {
        featured.map(({ album, cover }, i) =>
          cover ? (
            <div class={`slot slot--${i}`}>
              <AlbumCard
                album={album}
                cover={cover.src}
                variant={patterns[i]}
                index={i}
                eager={i === 0}
              />
            </div>
          ) : null,
        )
      }
    </div>
  </section>

  <!-- 摄影陈述 -->
  <section class="statement">
    <div class="container statement__inner js-reveal">
      <hr class="hairline" />
      <blockquote>
        人像想留住的，从来不是一张脸，<br />
        而是你<em>最松弛那一刻</em>的样子。
      </blockquote>
      <hr class="hairline" />
      <a href="/about/" class="btn">认识镜头背后的我</a>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding-top: calc(var(--nav-h) + 2.5rem);
    overflow: hidden;
    background:
      radial-gradient(60% 60% at 86% 16%, rgba(193, 99, 125, 0.14), transparent 62%),
      radial-gradient(52% 52% at 8% 88%, rgba(214, 171, 140, 0.18), transparent 62%);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .hero__text { padding-top: 2rem; }

  .hero__text .label { margin-bottom: 1.4rem; }

  .hero__text h1 {
    margin-bottom: 1.5rem;
    max-width: 12ch;
  }

  h1 em {
    font-style: italic;
    color: var(--accent);
  }

  .hero__intro {
    max-width: 42ch;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
    font-size: 1.05rem;
  }

  .hero__cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero__visual {
    position: relative;
  }

  .hero__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 999px 999px 22px 22px;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    box-shadow: 0 40px 90px rgba(193, 99, 125, 0.18);
  }

  .hero__frame:after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__badge {
    position: absolute;
    bottom: 8%;
    left: -6%;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--border-strong);
    box-shadow: 0 16px 40px rgba(150, 110, 95, 0.16);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    color: var(--text-secondary);
  }

  .hero__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: 3.5rem 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* 精选网格 */
  .works-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 2.5rem 2rem;
  }

  .slot--0 { grid-column: span 8; }
  .slot--1 { grid-column: span 4; padding-top: 3.5rem; }
  .slot--2 { grid-column: span 4; }
  .slot--3 { grid-column: span 8; padding-top: 3.5rem; }

  .all-link {
    margin-left: auto;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    color: var(--text-secondary);
    transition: color 0.3s var(--ease-out);
  }

  .all-link:hover { color: var(--accent-hover); }

  /* 陈述 */
  .statement {
    background: var(--bg-elevated);
    text-align: center;
  }

  .statement__inner {
    display: grid;
    justify-items: center;
    gap: 2.5rem;
    max-width: 720px;
  }

  blockquote {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.6vw, 2.3rem);
    line-height: 1.6;
    font-weight: 300;
  }

  blockquote em {
    font-style: italic;
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .works-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .slot--0, .slot--1, .slot--2, .slot--3 {
      grid-column: 1 / -1;
      padding-top: 0;
    }
    .hero { padding-top: calc(var(--nav-h) + 1.5rem); }
    .hero__grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero__text { padding-top: 0; }
    .hero__meta { flex-wrap: wrap; gap: 0.8rem; }
    .hero__badge { left: auto; right: -4%; }
  }
</style>
