---
import { site } from '../data/site';

const links = [
  { href: '/', label: '首页' },
  { href: '/albums/', label: '作品' },
  { href: '/about/', label: '关于' },
  { href: '/contact/', label: '联系' },
];

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header class="site-nav">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label={`${site.brand} 首页`}>
      <span class="brand__cn">{site.brand}</span>
      <span class="brand__en">{site.name}</span>
    </a>
    <nav aria-label="主导航">
      <ul class="nav-links">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={isActive(l.href) ? 'page' : undefined}
                class={isActive(l.href) ? 'is-active' : ''}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    transition: background 0.4s var(--ease-out), border-color 0.4s var(--ease-out);
    border-bottom: 1px solid transparent;
  }

  .site-nav.is-scrolled {
    background: var(--bg-overlay);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .brand__cn {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.32em;
    color: var(--text);
  }

  .brand__en {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    list-style: none;
  }

  .nav-links a {
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    color: var(--text-secondary);
    transition: color 0.3s var(--ease-out);
  }

  .nav-links a:hover,
  .nav-links a.is-active {
    color: var(--accent-hover);
  }

  @media (max-width: 600px) {
    .brand__cn { font-size: 1.05rem; letter-spacing: 0.22em; }
    .nav-links a { font-size: 0.74rem; }
  }
</style>
