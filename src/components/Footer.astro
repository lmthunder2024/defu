---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="brand-cn">{site.brand}</p>
        <p class="brand-tag">{site.tagline}</p>
      </div>

      <nav class="footer-col" aria-label="页脚导航">
        <p class="label">导航</p>
        <ul>
          <li><a href="/">首页</a></li>
          <li><a href="/albums/">作品</a></li>
          <li><a href="/about/">关于</a></li>
          <li><a href="/contact/">联系</a></li>
        </ul>
      </nav>

      <div class="footer-col">
        <p class="label">找到我</p>
        <ul>
          {
            site.socials.map((s) => (
              <li>
                <a href={s.url} rel="noopener">
                  {s.name} <span class="handle">{s.handle}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {site.name} · {site.brand}</span>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 4.5rem 0 calc(2.5rem + env(safe-area-inset-bottom, 0px));
    background: var(--bg-elevated);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.4fr;
    gap: 3rem;
    margin-bottom: 3.5rem;
  }

  .brand-cn {
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: 0.3em;
    margin-bottom: 0.5rem;
  }

  .brand-tag {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .footer-col ul {
    list-style: none;
    margin-top: 1.1rem;
    display: grid;
    gap: 0.55rem;
  }

  .footer-col a {
    color: var(--text-secondary);
    font-size: 0.85rem;
    transition: color 0.3s var(--ease-out);
  }

  .footer-col a:hover { color: var(--accent-hover); }

  .handle {
    color: var(--text-muted);
    font-size: 0.75rem;
    margin-left: 0.35rem;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  @media (max-width: 760px) {
    .footer-grid { grid-template-columns: 1fr; gap: 2.2rem; }
  }
</style>
